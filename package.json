{
  "name": "dj-crhis",
  "version": "1.0.0",
  "private": true,
  "description": "App DJ de escritorio — cabina personal con MIDI genérico",
  "author": "CRHIS",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:site": "CRHIS_NO_ELECTRON=1 vite",
    "build": "tsc --noEmit && vite build",
    "make-icon": "node scripts/make-icon.mjs",
    "dist": "npm run make-icon && npm run build && electron-builder",
    "dist:dir": "npm run make-icon && npm run build && electron-builder --dir",
    "dist:mac": "npm run make-icon && npm run build && electron-builder --mac",
    "dist:win": "npm run make-icon && npm run build && electron-builder --win"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^37.3.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.crhis.cabina",
    "productName": "CRHIS Cabina",
    "artifactName": "CRHIS-Cabina-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Crhisgv07",
        "repo": "Dj-Crhis",
        "releaseType": "release"
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "icon": "build/icon.png",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "dmg": {
      "title": "CRHIS Cabina ${version}"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "CRHIS Cabina"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "build/icon.png",
      "category": "Audio"
    }
  }
}
